# miniKanban Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Backend Configuration
# ============================================

# JWT Configuration
JWT_SECRET=your-secret-key-must-be-at-least-256-bits-long-change-this-in-production
JWT_EXPIRY_MS=900000
JWT_REFRESH_EXPIRY_DAYS=7

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/minikanban
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin

# Spring Profile (dev, test, docker, prod)
SPRING_PROFILES_ACTIVE=dev

# Server Configuration
SERVER_PORT=8080

# ============================================
# Frontend Configuration
# ============================================

# API Base URL
API_URL=http://localhost:8080

# ============================================
# Docker Configuration
# ============================================

# PostgreSQL
POSTGRES_DB=minikanban
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8080

# Frontend
FRONTEND_PORT=80

# ============================================
# Production Settings (Update for production)
# ============================================

# Generate a secure JWT secret:
# openssl rand -base64 64

# Use strong database credentials
# Enable SSL/TLS for database connections
# Set SPRING_PROFILES_ACTIVE=prod